# Copy to server/.env and replace the placeholders. Never commit server/.env.

# Development database (PostgreSQL 16).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cafe_feedback"

# Separate database used only by the automated tests. Its name must end in _test.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cafe_feedback_test"

# Password given to every demo account by the seed. Choose your own; share it privately.
SEED_PASSWORD="change-me"

# API port and environment (production turns on Secure cookies).
PORT=3000
NODE_ENV=development
